<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd">

  <servers>
    <server>
      <id>vprofile-snapshot</id>
      <username>admin</username>
      <password>admin123</password>
    </server>
    <server>
      <id>vprofile-release</id>
      <username>admin</username>
      <password>admin123</password>
    </server>
    <server>
      <id>vpro-maven-central</id>
      <username>admin</username>
      <password>admin123</password>
    </server>
    <server>
      <id>vpro-maven-repo</id>
      <username>admin</username>
      <password>admin123</password>
    </server>
  </servers>

  <!-- 🚫 Commented out the mirror to let Maven hit Maven Central directly -->
  <!--
  <mirrors>
    <mirror>
      <id>nexus</id>
      <name>Nexus Proxy</name>
      <url>http://18.118.26.162:8081/repository/vpro-maven-repo/</url>
      <mirrorOf>*,!central</mirrorOf>
    </mirror>
  </mirrors>
  -->

  <!-- ✅ Explicitly enable Maven Central -->
  <profiles>
    <profile>
      <id>central-direct</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>central-direct</activeProfile>
  </activeProfiles>

</settings>
